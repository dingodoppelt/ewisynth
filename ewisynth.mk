######################################################################
#
# ewisynth
#
######################################################################
#
# If you don't own a MOD Audio device, ignore this
#
# This file is needed to build ewisynth using the mod-plugin-builder.
# Copy this file into ~/mod-plugin-builder/plugins/package/ewisynth/
# Build the plugin with:
# ~/mod-plugin-builder/build moddwarf ewisynth
#
# This file can be used with the "mod-cloud-builder" as well:
#   Simply upload this file to: http://builder.mod.audio/buildroot
#
# This was AI generated by Google Gemini
#
######################################################################

EWISYNTH_VERSION = dpf
EWISYNTH_SITE = https://github.com/dingodoppelt/ewisynth.git
EWISYNTH_SITE_METHOD = git

# WICHTIG: fftw-single als Buildroot-Abhängigkeit für den MOD Dwarf
EWISYNTH_DEPENDENCIES = fftw-single

# Falls aubio oder andere Bibliotheken als Git-Submodules im Repo liegen:
EWISYNTH_PRE_DOWNLOAD_HOOKS += MOD_PLUGIN_BUILDER_DOWNLOAD_WITH_SUBMODULES

# Gibt an, welche LV2-Bundles gebaut/erwartet werden
EWISYNTH_BUNDLES = ewisynth.lv2

# Gemeinsame Optionen für Build und Install (aktiviert QEMU und ARM-Optimierungen)
EWISYNTH_MAKE_OPTS = \
        MOD_BUILD=true \
        EXE_WRAPPER="qemu-aarch64-static -L $(STAGING_DIR)" \
        CXXFLAGS="$(TARGET_CXXFLAGS) -mcpu=cortex-a35 -ftree-vectorize"

define EWISYNTH_BUILD_CMDS
        # 1. Waf-Skript für aubio automatisch via curl herunterladen und ausführbar machen
        curl -sSL -o $(@D)/aubio/waf https://waf.io/waf-2.0.26
        chmod +x $(@D)/aubio/waf

        # 2. Plugin für den MOD Dwarf kompilieren
        $(TARGET_MAKE_ENV) $(TARGET_CONFIGURE_OPTS) \
                $(EWISYNTH_MAKE_OPTS) \
                $(MAKE) -C $(@D)
endef

define EWISYNTH_INSTALL_TARGET_CMDS
        # Auch beim Installieren müssen MOD_BUILD und EXE_WRAPPER mitgegeben werden
        $(TARGET_MAKE_ENV) $(TARGET_CONFIGURE_OPTS) \
                $(EWISYNTH_MAKE_OPTS) \
                $(MAKE) -C $(@D) install DESTDIR=$(TARGET_DIR)
endef

$(eval $(generic-package))
